<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only what build settings cannot express; Xcode merges the generated keys
  (INFOPLIST_KEY_* in project.yml) into this file.

  Hayaki opens Anki's two package types. Their identifiers are the ones desktop
  Anki 26.09 declares for them (its macOS bundle, built with Briefcase from
  qt/installer/app/pyproject.toml: bundle "net.ankiweb", app "anki", document
  types "apkg" and "colpkg"). Hayaki does not own the types, so it imports the
  declarations and ranks itself as an alternate handler.
-->
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
		<string>zh-Hans</string>
	</array>
	<key>UIPrefersShowingLanguageSettings</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Hayaki uses the camera to add a picture to a note.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Anki Collection Package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.ankiweb.anki.colpkg</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Anki Deck Package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.ankiweb.anki.apkg</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Delimited Text</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.ankiweb.anki.colpkg</string>
			<key>UTTypeDescription</key>
			<string>Anki Collection Package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>colpkg</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-colpkg</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.ankiweb.anki.apkg</string>
			<key>UTTypeDescription</key>
			<string>Anki Deck Package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkg</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-apkg</string>
					<string>application/vnd.anki</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.amemiya02.hayaki.decks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hayaki</string>
			</array>
		</dict>
	</array>
	<key>NSMotionUsageDescription</key>
	<string>Hayaki detects a shake during study when you assign a reviewer command to it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hayaki uses the microphone when you record your voice while studying or editing a note.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Hayaki recognizes speech on this device when a card template requests it and you allow it.</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Exports and backups in Documents show in the Files app, under Hayaki. -->
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>

{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@)" : {
      "comment" : "A number and its share of the whole: in the card counts list, a state's cards; in the ratings list, a rating's reviews. E.g. \"12 (40%)\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）"
          }
        }
      }
    },
    "%@ Correct" : {
      "comment" : "Ratings list: label of the share of reviews of one kind of card not rated Again, e.g. \"Young Correct\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の正解率"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@正确率"
          }
        }
      }
    },
    "%@ learning, %@ review, %@ relearning, %@ filtered" : {

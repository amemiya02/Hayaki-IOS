{
  "sourceLanguage": "en",
  "strings": {
    "Export Selection as Deck Package" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択項目をデッキパッケージとしてエクスポート"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将选中内容导出为牌组包"
          }
        }
      }
    },
    "A backup of your previous collection was saved in the Backups folder.": {
      "comment": "Shown after a collection package replaced the collection, when a backup was made first.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のコレクションのバックアップを「Backups」フォルダに保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将原集合的备份保存到 Backups 文件夹。"
          }
        }
      }
    },
    "Add Duplicates": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加重复笔记"
          }
        }
      }
    },
    "Added": {
      "comment": "Import summary row: notes added from a deck package.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加"
          }
        }
      }
    },
    "All Decks": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデッキ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有牌组"
          }
        }
      }
    },
    "Allow HTML in Fields": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィールドで HTML を許可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许字段含有 HTML"
          }
        }
      }
    },
    "Always": {
      "comment": "Update choice: always replace with the package's copy.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に同期"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终"
          }
        }
      }
    },
    "Browse AnkiWeb": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnkiWeb で探す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览 AnkiWeb"
          }
        }
      }
    },
    "Cancel": {
      "comment": "Button that stops before importing or exporting a package.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancel Export": {
      "comment": "Button that stops an export while it runs.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートをキャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消导出"
          }
        }
      }
    },
    "Cancel Import": {
      "comment": "Button that stops an import while it runs.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートをキャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消导入"
          }
        }
      }
    },
    "Cards": {
      "comment": "Row label in the import summary: number of cards in the collection.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片"
          }
        }
      }
    },
    "Cards in Plain Text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードのプレーンテキスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯文本卡片"
          }
        }
      }
    },
    "Choose Text File": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストファイルを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文本文件"
          }
        }
      }
    },
    "Collection Package": {
      "comment": "Export choice: the whole collection as a collection package (.colpkg), as desktop Anki's 'Anki Collection Package'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションパッケージ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集合包"
          }
        }
      }
    },
    "Colon": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コロン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冒号"
          }
        }
      }
    },
    "Column %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列 %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 列"
          }
        }
      }
    },
    "Comma": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逗号"
          }
        }
      }
    },
    "Could Not Export": {
      "comment": "Title shown when an export failed.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートできませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导出"
          }
        }
      }
    },
    "Could Not Import": {
      "comment": "Title shown when an import failed.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートできませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入"
          }
        }
      }
    },
    "Deck": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "牌组"
          }
        }
      }
    },
    "Deck Package": {
      "comment": "Export choice: chosen decks as a deck package (.apkg), as desktop Anki's 'Anki Deck Package'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキパッケージ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "牌组包"
          }
        }
      }
    },
    "Decks": {
      "comment": "Row label in the import summary: number of decks in the collection; also the header of the deck list on the export screen.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "牌组"
          }
        }
      }
    },
    "Delimiter": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切り文字"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔符"
          }
        }
      }
    },
    "Done": {
      "comment": "Button that closes the import summary or the finished export.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Everything in Hayaki will be replaced by the collection in “%@”. A backup of your current collection is made first.": {
      "comment": "Warning before a collection package replaces the collection; the placeholder is the package's file name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayakiのデータを「%@」に含まれるコレクションで置き換えます。その前に現在のコレクションをバックアップします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayaki 中的所有内容将被“%@”中的集合替换。系统会先备份当前集合。"
          }
        }
      }
    },
    "Existing Notes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のノート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有笔记"
          }
        }
      }
    },
    "Export": {
      "comment": "Title of the export screen, the accessibility label of its kind picker, and the button that starts the export.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出"
          }
        }
      }
    },
    "Export Cancelled": {
      "comment": "Title shown after the learner cancelled an export.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートをキャンセルしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消导出"
          }
        }
      }
    },
    "Export Complete": {
      "comment": "Title shown when the package has been written.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートが完了しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出完成"
          }
        }
      }
    },
    "Export Text File": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストファイルを書き出す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出文本文件"
          }
        }
      }
    },
    "Exporting…": {
      "comment": "Shown while the core writes the package.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导出…"
          }
        }
      }
    },
    "Export…": {
      "comment": "Toolbar button on the deck list that opens the export screen.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出…"
          }
        }
      }
    },
    "Field Mapping": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィールドの割り当て"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字段映射"
          }
        }
      }
    },
    "Format": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式"
          }
        }
      }
    },
    "From File": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルから取得"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用文件中的值"
          }
        }
      }
    },
    "GUID Column": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GUID の列"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GUID 列"
          }
        }
      }
    },
    "Get Shared Decks": {
      "comment": "Opens the shared-deck catalog in a browser.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有デッキを入手"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取共享牌组"
          }
        }
      }
    },
    "Hayaki can import Anki collection packages (.colpkg) and deck packages (.apkg).": {
      "comment": "Shown when the learner opens a file that is not an Anki package.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HayakiはAnkiのコレクションパッケージ（.colpkg）とデッキパッケージ（.apkg）をインポートできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayaki 可以导入 Anki 集合包（.colpkg）和牌组包（.apkg）。"
          }
        }
      }
    },
    "Hayaki cannot reach its Documents folder.": {
      "comment": "Shown if the folder exports are saved in cannot be found.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayakiの書類フォルダにアクセスできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayaki 无法访问其文稿文件夹。"
          }
        }
      }
    },
    "If Newer": {
      "comment": "Update choice: replace only if the package's copy is newer.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい場合"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较新时"
          }
        }
      }
    },
    "Import": {
      "comment": "Button that starts importing a deck package with the chosen options.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入"
          }
        }
      }
    },
    "Import Cancelled": {
      "comment": "Title shown after the learner cancelled an import.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートをキャンセルしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消导入"
          }
        }
      }
    },
    "Import Complete": {
      "comment": "Title of the summary shown after an import finished.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートが完了しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入完成"
          }
        }
      }
    },
    "Import Deck Presets": {
      "comment": "Toggle: bring the deck presets (deck options) of a deck package's decks (Anki's 'Import any deck presets').",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキのプリセットをインポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入牌组预设"
          }
        }
      }
    },
    "Import Downloaded Deck": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたデッキを読み込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入已下载的牌组"
          }
        }
      }
    },
    "Import Learning Progress": {
      "comment": "Toggle: bring the scheduling and review history of a deck package's cards (Anki's 'Import any learning progress').",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習の進捗をインポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入学习进度"
          }
        }
      }
    },
    "Import Text File": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストファイルを読み込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入文本文件"
          }
        }
      }
    },
    "Import a Package…": {
      "comment": "Button that opens the file picker to choose an Anki collection package or deck package to import.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージをインポート…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入包…"
          }
        }
      }
    },
    "Importing “%@”…": {
      "comment": "Shown while a package imports; the placeholder is the file name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をインポート中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导入“%@”…"
          }
        }
      }
    },
    "Include Deck Name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキ名を含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含牌组名称"
          }
        }
      }
    },
    "Include Deck Presets": {
      "comment": "Toggle: put the presets (deck options) of the chosen decks in the deck package (desktop Anki's 'Include deck presets').",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキのプリセットを含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含牌组预设"
          }
        }
      }
    },
    "Include GUID": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GUID を含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含 GUID"
          }
        }
      }
    },
    "Include HTML": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML を含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含 HTML"
          }
        }
      }
    },
    "Include Media": {
      "comment": "Toggle: put the sounds and images in the package (desktop Anki's 'Include media').",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアを含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含媒体"
          }
        }
      }
    },
    "Include Note Type": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートタイプを含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含笔记类型"
          }
        }
      }
    },
    "Include Scheduling Information": {
      "comment": "Toggle: put the cards' scheduling and review history in the deck package (desktop Anki's 'Include scheduling information').",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュール情報を含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含排程信息"
          }
        }
      }
    },
    "Include Tags": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグを含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含标签"
          }
        }
      }
    },
    "Invalid Rows": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な行"
          }

{
  "sourceLanguage" : "en",
  "strings" : {
    "Force Full Sync…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全同期を強制…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制完整同步…"
          }
        }
      }
    },
    "Force Full Sync?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全同期を強制しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制完整同步？"
          }
        }
      }
    },
    "Force Full Sync" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全同期を強制"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制完整同步"
          }
        }
      }
    },
    "The next sync will ask whether to upload or download the collection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回の同期時に、コレクションをアップロードするかダウンロードするかを確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次同步时，将询问要上传还是下载集合。"
          }
        }
      }
    },
    "A full sync will run next time you sync." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回は完全同期が実行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次同步将进行完整同步。"
          }
        }
      }
    },
    "A one-way sync replaces one collection with the other. Choose which collection to keep." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一方向の同期では一方のコレクションが上書きされます。残すコレクションを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单向同步会用一份集合替换另一份。请选择要保留的集合。"
          }
        }
      }
    },
    "Keep Current Sign-In" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のログインを維持"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留当前登录"
          }
        }
      }
    },
    "Change Sync Destination…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期先を変更…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改同步目标…"
          }
        }
      }
    },
    "Change Sync Destination?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期先を変更しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改同步目标？"
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続ける"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续"
          }
        }
      }
    },
    "Your current sign-in will stay active until you sign in to the new destination." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい同期先にログインするまで、現在のログインは維持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录新目标前，当前登录将保持有效。"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Upload or download progress: bytes transferred of the total, such as “1.2 MB of 3.4 MB”.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "AnkiWeb" : {
      "comment" : "The hosted sync destination operated by Anki.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button that stops signing in or syncing.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Choose Which Collection to Keep" : {
      "comment" : "Title shown when the collection here and on the server cannot be merged.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残すコレクションを選択"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要保留的集合"
          }
        }
      }
    },
    "Collection download complete." : {
      "comment" : "Status shown after the collection has downloaded.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションのダウンロードが完了しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合下载完成。"
          }
        }
      }
    },
    "Collection sync complete." : {
      "comment" : "Status shown when collection changes have been exchanged.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションの同期が完了しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合同步完成。"
          }
        }
      }
    },
    "Collection upload complete." : {
      "comment" : "Status shown after the collection has uploaded.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションのアップロードが完了しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合上传完成。"
          }
        }
      }
    },
    "Connecting…" : {
      "comment" : "Shown while a sync connects to the server.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続中…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在连接…"
          }
        }
      }
    },
    "Could not reach AnkiWeb. Check your internet connection and try again." : {
      "comment" : "Shown when a network error prevents reaching AnkiWeb.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb に接続できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 AnkiWeb。请检查网络连接后重试。"
          }
        }
      }
    },
    "Could not reach the sync server at %@. Check the address, and that the server is running and reachable from this device." : {
      "comment" : "Failure: the server could not be reached. The placeholder is the server's host name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期サーバー「%@」に接続できませんでした。アドレスが正しいことと、サーバーが稼働していてこの端末から接続できることを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到同步服务器 %@。请检查地址，并确认服务器正在运行且此设备可以访问。"
          }
        }
      }
    },
    "Could not use the device's secure storage for the sign-in." : {
      "comment" : "Failure reading or writing the Keychain.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインに必要な端末の安全なストレージを使用できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录时无法使用设备的安全存储。"
          }
        }
      }
    },
    "Download from Server" : {
      "comment" : "Button that replaces this device's collection with the server's.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーからダウンロード"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从服务器下载"
          }
        }
      }
    },
    "Downloading…" : {
      "comment" : "Shown while the collection is downloaded from the server.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード中…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在下载…"
          }
        }
      }
    },
    "Email Address" : {
      "comment" : "The email address used to sign in to AnkiWeb.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアドレス"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电子邮件地址"
          }
        }
      }
    },
    "Enter the server's full address, starting with http:// or https://." : {
      "comment" : "Shown when the server address is not a web address.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// または https:// で始まるサーバーの完全なアドレスを入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入以 http:// 或 https:// 开头的完整服务器地址。"
          }
        }
      }
    },
    "Hayaki stores the sign-in key in this device’s Keychain." : {
      "comment" : "Footer of the sync sign-in form.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaki はサインインキーをこのデバイスのキーチェーンに保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaki 将登录密钥存储在此设备的钥匙串中。"
          }
        }
      }
    },
    "Media Sync" : {
      "comment" : "Heading for the media stage of sync.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアの同期"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体同步"
          }
        }
      }
    },
    "Media sync cancelled." : {
      "comment" : "Status shown after the learner cancelled syncing media.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアの同期をキャンセルしました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体同步已取消。"
          }
        }
      }
    },
    "Media sync complete." : {
      "comment" : "Status shown after the media stage finishes.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアの同期が完了しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体同步完成。"
          }
        }
      }
    },
    "Media sync failed." : {
      "comment" : "Status shown if the collection synced but the media stage failed.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアの同期に失敗しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体同步失败。"
          }
        }
      }
    },
    "Media sync was interrupted." : {
      "comment" : "Status shown on relaunch after the app closed while syncing media.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアの同期が中断されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体同步已中断。"
          }
        }
      }
    },
    "Not Now" : {
      "comment" : "Button that leaves both collections as they are instead of uploading or downloading.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後で"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不"
          }
        }
      }
    },
    "Off" : {
      "comment" : "Value of the Sync row in Settings when sync is not set up.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭"
          }
        }
      }
    },
    "Password" : {
      "comment" : "Label of the field for the password on the sync server.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码"
          }
        }
      }
    },
    "Replace the collection on the server with the one on this device. Changes that only the server has, from your other devices, are lost." : {
      "comment" : "Explains what uploading overwrites.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー上のコレクションをこの端末のもので置き換えます。他の端末による変更のうち、サーバーにしかないものは失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用此设备上的集合替换服务器上的集合。其他设备上仅同步到服务器的更改将丢失。"
          }
        }
      }
    },
    "Replace the collection on this device with the one on the server. Changes that only this device has are lost." : {
      "comment" : "Explains what downloading overwrites.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のコレクションをサーバー上のもので置き換えます。この端末にしかない変更は失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用服务器上的集合替换此设备上的集合。仅保存在此设备上的更改将丢失。"
          }
        }
      }
    },
    "Replace the empty collection on this device with the one on the server." : {
      "comment" : "Explains downloading into an empty collection.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の空のコレクションをサーバー上のもので置き換えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用服务器上的集合替换此设备上的空集合。"
          }
        }
      }
    },
    "Required" : {
      "comment" : "Placeholder of a sign-in field that must be filled in.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必须"
          }
        }
      }
    },
    "Retry Media Sync" : {
      "comment" : "Button that retries the media stage with the current sync destination.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアの同期を再試行"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试媒体同步"
          }
        }
      }
    },
    "Self-Hosted" : {
      "comment" : "Sync destination option for a server the learner runs or chooses.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セルフホスト"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自托管"
          }
        }
      }
    },
    "Send the collection on this device to the server, so your other devices can download it." : {
      "comment" : "Explains uploading to a server that has no collection yet.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のコレクションをサーバーに送信して、他の端末でダウンロードできるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此设备上的集合发送到服务器，以便其他设备下载。"
          }
        }
      }
    },
    "Server Address" : {
      "comment" : "Label of the field for the sync server's web address.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーアドレス"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器地址"
          }
        }
      }
    },
    "Sign In" : {
      "comment" : "Button that signs in to the sync server.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录"
          }
        }
      }
    },
    "Sign Out" : {
      "comment" : "Button that signs out of the sync server.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログアウト"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出登录"
          }
        }
      }
    },
    "Signing In…" : {
      "comment" : "Shown while signing in to the sync server.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン中…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在登录…"
          }
        }
      }
    },
    "Signing in failed." : {
      "comment" : "Sign-in failure for any other reason; the cause is shown below it.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインできませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录失败。"
          }
        }
      }
    },
    "Signing in was cancelled." : {
      "comment" : "Shown after the learner cancelled signing in.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインをキャンセルしました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已取消登录。"
          }
        }
      }
    },
    "Signing out removes the server's key from this device. Your collection stays on this device." : {
      "comment" : "Footer under Sign Out.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログアウトすると、この端末からサーバーの認証キーが削除されます。コレクションは端末に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

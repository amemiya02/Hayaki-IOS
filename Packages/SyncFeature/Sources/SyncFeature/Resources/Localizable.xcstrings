    },
    "Collection upload complete." : {
      "comment" : "Status shown after the collection has uploaded.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションのアップロードが完了しました。"

    },
    "Paste one PEM certificate for your HTTPS sync server. Clear the field to use the system’s default certificates." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS 同期サーバー用の PEM 証明書を 1 つ貼り付けてください。システムの標準証明書を使うには、欄を空にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请粘贴一份 HTTPS 同步服务器的 PEM 证书。清空此字段即可使用系统默认的证书。"
          }
        }
      }
    },

    "Enter a timeout from 30 to 99,999 seconds." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30〜99,999 秒の範囲で入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入 30 到 99,999 秒之间的超时时间。"
          }
        }
      }
    },
    "Enter one valid PEM certificate for an HTTPS sync server." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS 同期サーバー用の有効な PEM 証明書を 1 つ入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请为 HTTPS 同步服务器输入一份有效的 PEM 证书。"
          }
        }
      }
    },
    "Network Timeout" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークタイムアウト"

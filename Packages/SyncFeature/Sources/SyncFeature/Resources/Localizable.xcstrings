    "Sync Preferences" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期設定"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步偏好设置"
          }
        }
      }
    },
    "Syncing can use cellular data or count against this connection’s data limit." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期するとモバイルデータ通信を使用したり、この接続のデータ使用量に加算されたりすることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步可能会使用蜂窝数据，或计入当前网络的流量限额。"
          }
        }
      }
    },
    "Force Full Sync…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全同期を強制…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制完整同步…"
          }
        }
      }
    },
    "Force Full Sync?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全同期を強制しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制完整同步？"
          }
        }
      }
    },
    "Force Full Sync" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全同期を強制"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制完整同步"
          }
        }
      }
    },
    "The next sync will ask whether to upload or download the collection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回の同期時に、コレクションをアップロードするかダウンロードするかを確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次同步时，将询问要上传还是下载集合。"
          }
        }
      }
    },
    "A full sync will run next time you sync." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回は完全同期が実行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次同步将进行完整同步。"
          }
        }
      }
    },
    "A one-way sync replaces one collection with the other. Choose which collection to keep." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一方向の同期では一方のコレクションが上書きされます。残すコレクションを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单向同步会用一份集合替换另一份。请选择要保留的集合。"
          }
        }
      }
    },
    "Keep Current Sign-In" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のログインを維持"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留当前登录"
          }
        }
      }
    },
    "Change Sync Destination…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期先を変更…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改同步目标…"
          }
        }
      }
    },
    "Change Sync Destination?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期先を変更しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改同步目标？"
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続ける"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续"
          }
        }
      }
    },
    "Your current sign-in will stay active until you sign in to the new destination." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい同期先にログインするまで、現在のログインは維持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录新目标前，当前登录将保持有效。"
          }
        }
      }
    },
    "AnkiWeb" : {
      "comment" : "The hosted sync destination operated by Anki.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button that stops signing in or syncing.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Choose Which Collection to Keep" : {
      "comment" : "Title shown when the collection here and on the server cannot be merged.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残すコレクションを選択"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要保留的集合"
          }
        }
      }
    },
    "Could not reach AnkiWeb. Check your internet connection and try again." : {
      "comment" : "Shown when a network error prevents reaching AnkiWeb.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AnkiWeb に接続できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 AnkiWeb。请检查网络连接后重试。"
          }
        }
      }
    },
    "Could not reach the sync server at %@. Check the address, and that the server is running and reachable from this device." : {
      "comment" : "Failure: the server could not be reached. The placeholder is the server's host name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期サーバー「%@」に接続できませんでした。アドレスが正しいことと、サーバーが稼働していてこの端末から接続できることを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到同步服务器 %@。请检查地址，并确认服务器正在运行且此设备可以访问。"
          }
        }
      }
    },
    "Could not use the device's secure storage for the sign-in." : {
      "comment" : "Failure reading or writing the Keychain.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインに必要な端末の安全なストレージを使用できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录时无法使用设备的安全存储。"
          }
        }
      }
    },
    "Download from Server" : {
      "comment" : "Button that replaces this device's collection with the server's.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーからダウンロード"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从服务器下载"
          }
        }
      }
    },
    "Email Address" : {
      "comment" : "The email address used to sign in to AnkiWeb.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアドレス"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电子邮件地址"
          }
        }
      }
    },
    "Enter the server's full address, starting with http:// or https://." : {
      "comment" : "Shown when the server address is not a web address.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// または https:// で始まるサーバーの完全なアドレスを入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入以 http:// 或 https:// 开头的完整服务器地址。"
          }
        }
      }
    },
    "Hayaki stores the sign-in key in this device’s Keychain." : {
      "comment" : "Footer of the sync sign-in form.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaki はサインインキーをこのデバイスのキーチェーンに保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaki 将登录密钥存储在此设备的钥匙串中。"
          }
        }
      }
    },
    "Not Now" : {
      "comment" : "Button that leaves both collections as they are instead of uploading or downloading.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後で"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不"
          }
        }
      }
    },
    "Off" : {
      "comment" : "Value of the Sync row in Settings when sync is not set up.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭"
          }
        }
      }
    },
    "Password" : {
      "comment" : "Label of the field for the password on the sync server.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码"
          }
        }
      }
    },
    "Replace the collection on the server with the one on this device. Changes that only the server has, from your other devices, are lost." : {
      "comment" : "Explains what uploading overwrites.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー上のコレクションをこの端末のもので置き換えます。他の端末による変更のうち、サーバーにしかないものは失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用此设备上的集合替换服务器上的集合。其他设备上仅同步到服务器的更改将丢失。"
          }
        }
      }
    },
    "Replace the collection on this device with the one on the server. Changes that only this device has are lost." : {
      "comment" : "Explains what downloading overwrites.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のコレクションをサーバー上のもので置き換えます。この端末にしかない変更は失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

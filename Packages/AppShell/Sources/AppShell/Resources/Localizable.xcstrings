    "Restore “%@” to this device? The damaged database is copied to Backups first." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をこのデバイスに復元しますか？破損したデータベースは先に Backups にコピーされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将“%@”恢复到此设备吗？损坏的数据库会先复制到备份文件夹。"
          }
        }
      }
    },

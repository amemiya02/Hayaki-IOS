          }
        }
      }
    },
    "Enter a profile name." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール名を入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入用户配置名。"
          }
        }
      }
    },
    "Enter a profile name of 50 characters or fewer." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール名は50文字以内で入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户配置名不得超过 50 个字符。"
          }
        }
      }
    },
    "A profile already uses this name." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前は既に使われています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此用户配置名已存在。"
          }
        }
      }
    },
    "This profile is unavailable." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールは使用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用此用户配置。"
          }
        }
      }
    },
    "Wait for the current collection operation to finish, then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションの処理が完了してから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待当前集合操作完成后重试。"
          }
        }
      }
    },
    "Save" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存"

          "stringUnit" : {
            "state" : "translated",
            "value" : "復元パッケージを選択"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择恢复包"
          }
        }
      }
    },
    "Restore Collection?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを復元しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复集合？"

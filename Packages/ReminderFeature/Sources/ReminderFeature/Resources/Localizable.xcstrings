              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく学習できるカードが%lld枚あります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 张新卡片可以学习。"
          }
        }
      }
    },
    "Allow Hayaki notifications in Settings to receive deck reminders." : {
      "localizations" : {
        "ja" : {

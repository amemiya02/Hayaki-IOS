      "comment" : "Browse: accessibility label of the menu of actions on the selected cards (flag, move, suspend, delete)."
    },
    "Added" : {
      "comment" : "Card detail: label of the date the card's note was added."
    },
    "Again" : {
      "comment" : "Card detail, review history: the Again rating."
    },
    "Anki search, such as deck:Spanish" : {
      "comment" : "Prompt in the Browse search field; the search uses Anki's search syntax. Keep 'deck:' untranslated."
    },
    "Ascending" : {
      "comment" : "Browse sort menu: sort from lowest to highest (A to Z, oldest first)."
    },
    "Blue" : {
      "comment" : "Browse: a flag colour, in the Filter and Flag menus."
    },

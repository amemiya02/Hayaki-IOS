    "%@× the workload at %@%% retention" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持率 %2$@%% のときの負荷の %1$@ 倍"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是记忆保留率为 %2$@%% 时的 %1$@ 倍"

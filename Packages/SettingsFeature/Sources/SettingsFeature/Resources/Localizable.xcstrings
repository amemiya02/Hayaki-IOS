    "Hayaki will check the collection database and repair any problems it can." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaki はコレクションデータベースをチェックし、修復できる問題を修復します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaki 会检查集合数据库，并尝试修复发现的问题。"
          }
        }
      }
    },
    "You can restore these files from the media trash." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのファイルはメディアのゴミ箱から復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以从媒体废纸篓恢复这些文件。"
          }
        }
      }
    },
    "Files in the media trash will be permanently deleted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアのゴミ箱にあるファイルは完全に削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体废纸篓中的文件将永久删除。"
          }
        }
      }
    },

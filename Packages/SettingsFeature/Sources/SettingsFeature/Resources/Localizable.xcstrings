          }
        }
      }
    },
    "Use the same sync destination on your other devices. To switch destinations, sign out first." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの端末でも同じ同期先を使用してください。同期先を切り替えるには、先にログアウトします。"
          }
        },
        "zh-Hans" : {

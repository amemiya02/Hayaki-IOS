{
  "sourceLanguage" : "en",
  "strings" : {
    "A collection package (.colpkg) replaces the receiving collection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションパッケージ（.colpkg）は、取り込み先のコレクション全体を置き換えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合包（.colpkg）会替换接收端的整个集合。"
          }
        }
      }
    },
    "A deck package (.apkg) merges into the receiving collection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デッキパッケージ（.apkg）は、取り込み先のコレクションに統合されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "牌组包（.apkg）会合并到接收端的集合中。"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリについて"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于"
          }
        }
      }
    },
    "Added an in-app transfer guide, help links and build information." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内の移行ガイド、ヘルプへのリンク、ビルド情報を追加しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增应用内迁移指南、帮助链接和构建信息。"
          }
        }
      }
    },

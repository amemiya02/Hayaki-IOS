    "Enter the number of days until the card is due. Use 0 for today or a range such as 3-7." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの期日までの日数を入力します。今日なら 0、範囲なら 3-7 のように入力します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入距离卡片到期的天数。输入 0 表示今天，也可输入 3-7 这样的范围。"
          }
        }
      }
    },
    "Reset" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {

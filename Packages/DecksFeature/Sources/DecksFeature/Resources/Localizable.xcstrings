    "%lld cards will be deleted with it." : {
      "comment" : "Message of the alert confirming a deck's deletion, for a deck without child decks; the number is how many cards are deleted.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld card will be deleted with it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cards will be deleted with it."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に%lld枚のカードも削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时会删除其中的 %lld 张卡片。"
          }
        }
      }
    },
    "%lld due today" : {
      "comment" : "Available cards in all decks for the current study day.",

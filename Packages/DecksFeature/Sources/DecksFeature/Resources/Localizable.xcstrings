    "%lld new, %lld learning, %lld due" : {
      "comment" : "VoiceOver label for a deck's counts for today: new cards, learning cards and due review cards."
    },
    "Bring your cards in from Anki or AnkiDroid by importing a collection package (.colpkg) or a deck package (.apkg)." : {
      "comment" : "Explains on the first-launch screen how to bring existing cards in."
    },

    "Import a deck package (.apkg) or a collection package (.colpkg) from Hayaki, Anki or AnkiDroid." : {
      "comment" : "Explains how to bring existing cards into an empty collection.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayaki、Anki、AnkiDroid のデッキパッケージ（.apkg）またはコレクションパッケージ（.colpkg）をインポートできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以从 Hayaki、Anki 或 AnkiDroid 导入牌组包（.apkg）或集合包（.colpkg）。"
          }
        }
      }
    },
    "Inside" : {
      "comment" : "New Deck sheet: label of the choice of deck the new deck goes inside."
